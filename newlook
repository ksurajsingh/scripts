#!/bin/sh

wall_dir=/mnt/KSS/Media/wallpapers/

while true; do

	pkill wallset
	pkill xwallpaper
	pkill wal
	wallset -q

  if [[ ! -d "$wall_dir" ]]; then
    wall_dir="$HOME/dots/"
  fi

  wall=$(find $wall_dir -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.mp4" \) | shuf -n 1)


	if [ "${wall##*.}" = "mp4" ]; then
	    wallset --video  "$wall"
	else
	    xwallpaper --maximize "$wall"
	fi

  cur_wall_dir=$HOME/.cache/newlook
  
  if [[ ! -d "$cur_wall_dir" ]];then
    mkdir -p "$cur_wall_dir"
  fi

  echo "$wall" >> $cur_wall_dir/cur_wal
	wal -c 
	wal -i "$wall"
	
	dunst.wal.scheme
  sleep 15
	xdotool key super+F5
	
	if [ "${wall##*.}" = "mp4" ]; then
		sleep 86400
	else
		sleep 7200
	fi

done
