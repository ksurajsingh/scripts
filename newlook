#!/bin/sh

wall_dir=/mnt/KSS/Media/wallpapers/

while true; do

	pkill wallset
	pkill xwallpaper
	pkill wal
	wallset -q

  if [[ -d "$wall_dir" ]]; then
    wall=$(find  -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.mp4" \) | shuf -n 1)
  else
    wall=$(ls $HOME/dot-files/*.(jpg|png))


	if [ "${wall##*.}" = "mp4" ]; then
	    wallset --video  "$wall"
	else
	    xwallpaper --maximize "$wall"
	fi

	wal -c 
	wal -i "$wall"
	
	xdotool key super+F5
	dunst.wal.scheme
	
	if [ "${wall##*.}" = "mp4" ]; then
		sleep 86400
	else
		sleep 1800
	fi

done


